rules_version = '2';

// Cramly Firebase Storage security rules.
// Mirrors the Firestore strategy: per-user namespace, owner-only access,
// 50MB upload cap, content-type allowlist for safety.

service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Writes must satisfy size + content-type constraints.
      // Server-side writes via Admin SDK bypass these rules.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches(
                        'application/pdf|'
                        + 'image/.*|'
                        + 'audio/.*|'
                        + 'application/vnd.openxmlformats-.*|'
                        + 'application/msword|'
                        + 'application/vnd.ms-powerpoint|'
                        + 'text/markdown|'
                        + 'text/plain'
                      );
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
