# Cramly backend env vars
# Copy to backend/.env for local development. Never commit the real .env.
# In production, set these in Render's dashboard for both services.

# --- Runtime ---
ENV=development          # development | production
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
SERVICE_NAME=cramly-api  # cramly-api | cramly-worker (set per service)

# --- Firebase Admin SDK ---
# Set ONE of the two below.
#
# Local dev (recommended): point at the JSON file on disk. No escaping headaches.
# Generate the file from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Move it OUT of Downloads to a stable path.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\iamha\.cramly-secrets\service-account.json

# Render production: paste the entire JSON as a single-line string in the Render
# dashboard env vars (Render doesn't have a filesystem you can drop files into).
# Leave blank locally if PATH is set above.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID (must match the service account's project_id)
FIREBASE_PROJECT_ID=cramly-cd9b5

# Firebase Storage bucket (new default uses .firebasestorage.app)
FIREBASE_STORAGE_BUCKET=cramly-cd9b5.firebasestorage.app

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- TTS ---
ELEVENLABS_API_KEY=

# --- Worker tuning (worker service only) ---
WORKER_ID=                       # leave blank locally; Render injects unique ID per instance
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
