{
  "name": "cramly-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "capture:demo": "node scripts/capture-demo.mjs",
    "lint": "eslint . --max-warnings 0",
